{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmdmint.local/schema/primitive-manifest.schema.json",
  "title": "Cmdmint primitive manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "description",
    "binary",
    "learnedAt",
    "engine",
    "methods"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "description": { "type": "string", "minLength": 1 },
    "binary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "path", "version", "sha256", "size", "mtimeMs"],
      "properties": {
        "requested": { "type": "string" },
        "path": { "type": "string" },
        "version": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "size": { "type": "integer", "minimum": 0 },
        "mtimeMs": { "type": "number", "minimum": 0 }
      }
    },
    "learnedAt": { "type": "string", "format": "date-time" },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "provider", "model", "thinking"],
      "properties": {
        "kind": { "const": "pi" },
        "provider": { "const": "openai-codex" },
        "model": { "const": "gpt-5.6-luna" },
        "thinking": { "const": "high" }
      }
    },
    "ask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "parameter"],
      "properties": {
        "method": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
        },
        "parameter": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        }
      }
    },
    "methods": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/method" }
    }
  },
  "$defs": {
    "parameter": {
      "type": "object",
      "required": ["name", "description", "kind", "type", "required"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "description": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["positional", "option"] },
        "type": { "enum": ["string", "integer", "number", "boolean", "string[]"] },
        "required": { "type": "boolean" },
        "default": {
          "oneOf": [
            { "type": "string" },
            { "type": "number" },
            { "type": "boolean" },
            { "type": "array", "items": { "type": "string" } }
          ]
        },
        "enum": {
          "type": "array",
          "items": { "type": ["string", "number"] }
        },
        "position": { "type": "integer", "minimum": 0 },
        "flag": { "type": "string", "pattern": "^--?[a-zA-Z0-9][a-zA-Z0-9-]*$" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "positional" } } },
          "then": { "required": ["position"] }
        },
        {
          "if": { "properties": { "kind": { "const": "option" } } },
          "then": { "required": ["flag"] }
        }
      ]
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "risk",
        "argv",
        "parameters",
        "output",
        "evidenceId",
        "probe"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
        },
        "description": { "type": "string", "minLength": 1 },
        "risk": { "enum": ["read", "write", "destructive"] },
        "argv": {
          "type": "array",
          "maxItems": 16,
          "items": { "type": "string", "minLength": 1 }
        },
        "parameters": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/parameter" }
        },
        "output": { "enum": ["text", "json", "jsonl"] },
        "evidenceId": { "type": "string", "minLength": 1 },
        "probe": {
          "type": "object",
          "additionalProperties": false,
          "required": ["argv", "expectExit"],
          "properties": {
            "argv": { "type": "array", "items": { "type": "string" } },
            "expectExit": { "type": "array", "items": { "type": "integer" } }
          }
        }
      }
    }
  }
}
