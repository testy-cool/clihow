{
  "name": "cmdmint",
  "version": "0.1.0",
  "description": "Mint installed CLIs into tested, agent-discoverable primitives.",
  "type": "module",
  "bin": {
    "cmdmint": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "check": "pnpm test && pnpm build"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
